{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // the genoffice CLI's tool surface reaches @genoffice/ui, whose modules are
    // typed against the DOM even though the daemon never touches a window
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  // the genoffice CLI tool surface pulls in DOM/renderer modules that expect the
  // same ambient declarations the CLI's own tsconfig carries
  "include": [
    "src",
    "tests",
    "../cli/src/jsdom.d.ts",
    "../pdf2docx/src/bidi-js.d.ts",
    "../pptx-ops/src/raw.d.ts",
    "../../apps/docs/src/renderer/env.d.ts",
    "../../apps/markdown/src/renderer/env.d.ts",
    "../../apps/markdown/src/renderer/types/wavedrom.d.ts"
  ]
}
